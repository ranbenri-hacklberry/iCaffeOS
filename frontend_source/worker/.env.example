# ── Supabase (use service_role key — bypasses RLS) ────────────────────
SUPABASE_URL=https://gxzsxvbercpkgxraiaex.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Business Identity ─────────────────────────────────────────────────
# UUID of the business whose jobs this worker processes.
# Run: SELECT id FROM businesses WHERE name = 'iCaffe';
BUSINESS_ID=your-business-uuid-here

# ── WAHA (WhatsApp HTTP API) ──────────────────────────────────────────
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default          # WAHA session name
WAHA_RATE_MS=1200             # ms between messages (avoid WA ban: 1.2s min)

# ── Local SMS Modem (Python script on Ryzen) ─────────────────────────
MODEM_SCRIPT_PATH=/home/ran/modem-scripts/send_sms.py
MODEM_TIMEOUT_MS=30000        # 30s max per SMS

# ── GlobalSMS (Cloud fallback) ────────────────────────────────────────
GLOBALSMS_API_URL=https://api.globalsms.com/v1/send
GLOBALSMS_API_KEY=your-globalsms-api-key
GLOBALSMS_SENDER=iCaffe       # Sender ID (max 11 chars, alphanumeric)

# ── Dispatcher Behaviour ─────────────────────────────────────────────
POLL_INTERVAL_MS=5000         # How often to poll for new jobs (ms)
JOB_BATCH_SIZE=5              # Max concurrent jobs per poll cycle
MAX_RETRIES=3                 # Abort a job after this many retries
LOG_LEVEL=info                # debug | info | warn | error

# ── Zombie Reaper ────────────────────────────────────────────────────
ZOMBIE_TIMEOUT_MIN=10         # Minutes a job can be 'running' before it's declared zombie
REAPER_EVERY_N_CYCLES=12      # Run reaper every N poll cycles (12 × 5s = ~60s)
                              # Ignored if pg_cron is enabled in Supabase (pg_cron takes priority)
