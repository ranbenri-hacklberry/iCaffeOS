FROM node:20-alpine

# Install curl for healthcheck, python3 + ffmpeg + yt-dlp for YouTube
RUN apk add --no-cache curl python3 py3-pip ffmpeg && \
    pip3 install --break-system-packages yt-dlp

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose the backend port
EXPOSE 8080

# Start the backend server
CMD ["node", "backend_server.js"]
